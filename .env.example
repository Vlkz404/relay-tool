# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=3333

# Database: local Docker by default; replace with the Supabase pooled/direct URL in production.
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_control

# Evolution API — never commit real credentials.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_me
EVOLUTION_DEFAULT_INSTANCE=BOT

# AI (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Storage: local for development. Use Supabase Storage/S3 in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data

